generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// A teacher or researcher who runs classes through the app.
model Facilitator {
  id           String               @id @default(uuid()) @db.Uuid
  email        String               @unique @db.Text
  /// Lowercase login name. Null only for accounts created before usernames existed.
  username     String?              @unique @db.Text
  displayName  String               @db.Text
  /// scrypt hash in the form scrypt$N$r$p$salt$hash. Never returned by the API.
  passwordHash String               @db.Text
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)
  sessions     FacilitatorSession[]
  cohorts      Cohort[]

  @@map("facilitators")
}

/// Server-side login session. Only a SHA-256 hash of the cookie token is stored.
model FacilitatorSession {
  id            String      @id @default(uuid()) @db.Uuid
  tokenHash     String      @unique @db.Text
  facilitatorId String      @db.Uuid
  facilitator   Facilitator @relation(fields: [facilitatorId], references: [id], onDelete: Cascade)
  expiresAt     DateTime    @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@index([facilitatorId])
  @@index([expiresAt])
  @@map("facilitator_sessions")
}

/// One class (cohort) that students join with a code and get placed into teams.
model Cohort {
  id            String      @id @default(uuid()) @db.Uuid
  facilitatorId String      @db.Uuid
  facilitator   Facilitator @relation(fields: [facilitatorId], references: [id], onDelete: Cascade)
  name          String      @db.Text
  term          String?     @db.Text
  joinCode      String      @unique @db.Text
  /// Smallest team size.
  teamSize      Int
  /// Largest team size; equal to teamSize for a fixed size.
  teamSizeMax   Int
  /// collecting | teams-draft | teams-locked
  status        String      @default("collecting") @db.Text
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  students      Student[]
  projects      Project[]
  teams         Team[]

  @@index([facilitatorId, createdAt])
  @@map("cohorts")
}

/// A student who joined a class. Their questionnaire answers are in Answer.
model Student {
  id          String           @id @default(uuid()) @db.Uuid
  cohortId    String           @db.Uuid
  cohort      Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  displayName String           @db.Text
  email       String           @db.Text
  joinedAt    DateTime         @default(now()) @db.Timestamptz(3)
  /// Set once every questionnaire is finished.
  completedAt DateTime?        @db.Timestamptz(3)
  answers     Answer[]
  sessions    StudentSession[]

  @@unique([cohortId, email])
  @@map("students")
}

/// A project that teams in a class will work on.
model Project {
  id          String   @id @default(uuid()) @db.Uuid
  cohortId    String   @db.Uuid
  cohort      Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  title       String   @db.Text
  description String   @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([cohortId])
  @@map("projects")
}

/// A formed team. Membership is added with the team-forming step.
model Team {
  id        String   @id @default(uuid()) @db.Uuid
  cohortId  String   @db.Uuid
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  name      String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([cohortId])
  @@map("teams")
}

/// One student's answer to one question.
model Answer {
  id               String   @id @default(uuid()) @db.Uuid
  studentId        String   @db.Uuid
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// "work-style" or "skills"
  questionnaireId  String   @db.Text
  /// The question's id from the code, e.g. "ws-01" or "sk-projects".
  questionId       String   @db.Text
  /// A number 1–5 for scale questions, or a list of option ids for rank questions.
  value            Json
  /// Which version of the questions this was answered on, so old answers still make sense after edits.
  questionsVersion String   @default("1") @db.Text
  answeredAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@unique([studentId, questionId])
  @@index([studentId, questionnaireId])
  @@map("answers")
}

/// A student's login session. Only a SHA-256 hash of the cookie token is stored.
model StudentSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.Text
  studentId String   @db.Uuid
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([studentId])
  @@index([expiresAt])
  @@map("student_sessions")
}
