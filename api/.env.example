# `npm run setup` copies this file to api/.env and fills DATABASE_URL.
DATABASE_URL=
API_HOST=127.0.0.1
API_PORT=8788

# How long a facilitator stays logged in.
SESSION_TTL_HOURS=12
# Set to true when the site is served over HTTPS so the session cookie is Secure.
SESSION_COOKIE_SECURE=false

# Optional. When set, creating a facilitator account requires this code.
# Leave empty for local development; set it before deploying anywhere public.
FACILITATOR_INVITE_CODE=
