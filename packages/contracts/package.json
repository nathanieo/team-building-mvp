{
  "name": "@team-building-mvp/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe TypeScript contracts shared by the frontend and API.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "oxlint": "1.71.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
